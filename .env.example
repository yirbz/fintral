# =============================================================================
# Fintral — Environment Variables Reference
# =============================================================================
#
# INSTRUCCIONES PARA DESARROLLO LOCAL:
# 1. Copia este archivo como `.env`: `cp .env.example .env`
# 2. Las variables de infraestructura local (no comentadas) funcionan automáticamente.
# 3. Las variables sensibles (comentadas con `#`) se obtienen de Doppler
#    al arrancar con `just dev-up` (requiere `doppler setup` previo).
#
# =============================================================================

# =============================================================================
# ── 1. LOCAL DEV INFRASTRUCTURE ────────────────────────────────────────────
# =============================================================================
# Configuración de topología local (puertos y URLs de contenedores Docker).
# No son secretos — definen cómo se comunican los servicios en desarrollo local.

ENVIRONMENT=DEVELOPMENT
BACKEND_PORT=4000
FRONTEND_PORT=3000
REDIS_PORT=6381
PROXY_PORT=8080

# URLs de conexión de contenedores Docker (red interna)
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
LOCAL_DATABASE_URL=postgresql://postgres:postgres@supabase_db_fintral-dev:5432/postgres
LOCAL_REDIS_URL=redis://redis:6379/0
SUPABASE_STORAGE_BUCKET=invoices
LOCAL_NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# ── 2. DOPPLER SECRETS (Commented out - Fetched from Doppler) ─────────────────
# =============================================================================
# Estas variables contienen llaves API y contraseñas sensibles.
# Configuradas en Doppler (config 'dev' o 'dev_personal') y NO escritas en .env.

# ── JWT signing ──
# # APP_JWT_SECRET_KEY=change_me_to_a_long_random_string
# ── Supabase Cloud Credentials (not used in local dev, CLI covers it) ──
# # SUPABASE_URL=https://your-project.supabase.co
# # SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Admin Bootstrap (created on backend initialization) ──
# # ADMIN_EMAIL=admin@fintral.app
# # ADMIN_PASSWORD=change_me_strong_password
# # ADMIN_FULL_NAME=Admin

# ── LLM Pipeline (OCR + extracción) ──
# # AI_PIPELINE_KEY=AIzaSy...
# # AI_PIPELINE_MODEL=gemini-2.5-flash-lite
# # AI_PIPELINE_FALLBACK_MODEL=gemini-3.1-flash-lite

# ── AI Chat Sidebar ──
# # AI_SIDECAR_KEY=AIzaSy...
# # AI_SIDECAR_MODEL=gemini-2.5-flash
# # AI_SIDECAR_FALLBACK_MODEL=gemini-3.1-flash-lite

# ── Email (Resend) ──
# # RESEND_API_KEY=re_...
# # EMAIL_FROM=Fintral <onboarding@noreply.fintral.app>

# ── QuickBooks Integration ──
# # QUICKBOOKS_CLIENT_ID=your_client_id
# # QUICKBOOKS_CLIENT_SECRET=your_client_secret
# # QUICKBOOKS_REDIRECT_URI=http://localhost:4000/api/integrations/quickbooks/callback

# ── Xero Integration ──
# # XERO_CLIENT_ID=your_client_id
# # XERO_CLIENT_SECRET=your_client_secret
# # XERO_REDIRECT_URI=http://localhost:4000/api/integrations/xero/callback

# ── Alanube (DGII electronic invoicing — Dominican Republic) ──
# # ALANUBE_API_URL=https://sandbox-api.alanube.co/dom/v1
# # ALANUBE_JWT=your_jwt_here
