# Environment (PROD | DEVELOPMENT)
ENVIRONMENT=PROD

# Core
SECRET_KEY=change_me_to_a_long_random_string
PORT=8000

# Supabase (Database + Auth — required in PROD, ignored in DEVELOPMENT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Admin (autocreación en startup vía Supabase Auth)
ADMIN_EMAIL=admin@fintral.com
ADMIN_PASSWORD=change_me_strong_password
ADMIN_FULL_NAME=Admin

# Default organization (created on bootstrap)
ORG_NAME=Mi Empresa S.A.
ORG_TAX_ID=
ORG_COUNTRY=DO
TENANT_PLAN=free

# Redis (local dev) / Upstash (production)
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your_key
OPENAI_DAILY_LIMIT_USD=10.0
OPENAI_HOURLY_LIMIT_REQUESTS=100

# Resend (email delivery — transactional emails, verification)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Fintral <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3000

# WhatsApp / Evolution API
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY
EVOLUTION_INSTANCE_NAME=your_instance
EVOLUTION_INSTANCE_TOKEN=your_instance_token
AUTHORIZED_WHATSAPP_NUMBER=15555550100

# QuickBooks Online (OAuth 2.0)
QUICKBOOKS_CLIENT_ID=your_client_id_from_intuit
QUICKBOOKS_CLIENT_SECRET=your_client_secret_from_intuit
QUICKBOOKS_REDIRECT_URI=http://localhost:8003/api/integrations/quickbooks/callback
QUICKBOOKS_SANDBOX=true

# Xero (OAuth 2.0)
XERO_CLIENT_ID=your_client_id_from_xero
XERO_CLIENT_SECRET=your_client_secret_from_xero
XERO_REDIRECT_URI=http://localhost:8003/api/integrations/xero/callback

# Alanube API (Dominican Electronic Invoicing)
ALANUBE_API_URL=https://sandbox-api.alanube.co/dom/v1
ALANUBE_JWT=your_jwt_here

