# =============================================================================
# Fintral — Environment Variables Reference
# =============================================================================
#
# INSTRUCCIONES PARA DESARROLLO LOCAL:
# 1. Copia este archivo como `.env`: `cp .env.example .env`
# 2. Las variables de infraestructura local (no comentadas) funcionarán automáticamente.
# 3. Las variables sensibles/secretos (comentadas con `#`) se obtienen automáticamente
#    de Doppler al arrancar con `just dev-up` (ejecuta `doppler setup` previamente).
#
# =============================================================================

# =============================================================================
# ── 1. LOCAL DEV INFRASTRUCTURE (Uncommented - Loaded from local .env) ──────
# =============================================================================
# Configuración específica para los contenedores y puertos locales de desarrollo.
# No compartas contraseñas reales aquí.

LOCAL_ENVIRONMENT=DEVELOPMENT
LOCAL_BACKEND_PORT=8000
LOCAL_FRONTEND_PORT=3000
LOCAL_REDIS_PORT=6381
LOCAL_PROXY_PORT=8001

# URLs de conexión de contenedores de Docker (red interna)
SUPABASE_URL=http://supabase_kong_fintral-dev:8000
LOCAL_DATABASE_URL=postgresql://postgres:postgres@supabase_db_fintral-dev:5432/postgres
LOCAL_REDIS_URL=redis://redis:6379/0
SUPABASE_STORAGE_BUCKET=invoices
LOCAL_NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# ── 2. DOPPLER SECRETS & KEYS (Commented out - Fetched from Doppler) ─────────
# =============================================================================
# Estas variables contienen llaves API y contraseñas sensibles.
# Deben estar configuradas en Doppler (configuración 'dev') y NO escritas en tu .env.

# ── JWT signing & HMAC Webhook Verification ──
# # APP_JWT_SECRET_KEY=change_me_to_a_long_random_string_here

# ── Supabase Cloud Credentials (not used in local dev, CLI covers it) ──
# # SUPABASE_URL=https://your-project.supabase.co
# # SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Admin Bootstrap (created on backend initialization) ──
# # ADMIN_EMAIL=admin@fintral.com
# # ADMIN_PASSWORD=change_me_strong_password
# # ADMIN_FULL_NAME=Admin

# ── Caching & Queue ──
# # REDIS_URL=rediss://default:token@upstash-url:6379/0

# ── LLM & AI Pipeline (Agnostified API Key) ──
# # AI_MODEL_API_KEY=sk-your_key
# # AI_MODEL_NAME=gemini-2.0-flash

# ── AI Assistant (AI Chat Sidebar) ──
# Google Gemini API key for the AI Chat Sidebar feature.
# Falls back to OPENAI_API_KEY if not set.
# # AI_ASSISTANT_KEY=AIzaSy...here
# # AI_ASSISTANT_MODEL=gemini-2.5-flash

# ── Email Service (Resend) ──
# # RESEND_API_KEY=re_your_api_key_here
# # EMAIL_FROM=Fintral <onboarding@resend.dev>

# ── QuickBooks Integration ──
# # QUICKBOOKS_CLIENT_ID=your_client_id_from_intuit
# # QUICKBOOKS_CLIENT_SECRET=your_client_secret_from_intuit
# # QUICKBOOKS_REDIRECT_URI=http://localhost:8003/api/integrations/quickbooks/callback
# # QUICKBOOKS_SANDBOX=true

# ── Xero Integration ──
# # XERO_CLIENT_ID=your_client_id_from_xero
# # XERO_CLIENT_SECRET=your_client_secret_from_xero
# # XERO_REDIRECT_URI=http://localhost:8003/api/integrations/xero/callback

# ── Alanube Integration (Dominican Republic DGII) ──
# # ALANUBE_API_URL=https://sandbox-api.alanube.co/dom/v1
# # ALANUBE_JWT=your_jwt_here

# =============================================================================
# ── 3. STAGING CONFIGURATION (Commented out - Reference only) ────────────────
# =============================================================================
# Configuración del entorno de Staging (pre-producción).
# Administrada 100% en Doppler config 'stg'.

# # ENVIRONMENT=STAGING
# # BACKEND_PORT=8000
# # DATABASE_URL=postgresql://postgres:[STG_PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
# # SUPABASE_URL=https://stg-project.supabase.co
# # SUPABASE_SERVICE_ROLE_KEY=stg_service_role_key
# # REDIS_URL=rediss://default:stg_token@stg-upstash-url:6379/0
# # PUBLIC_APP_URL=https://staging.fintral.do

# =============================================================================
# ── 4. PRODUCTION CONFIGURATION (Commented out - Reference only) ─────────────
# =============================================================================
# Configuración del entorno de Producción en la nube.
# Administrada 100% en Doppler config 'prod'.

# # ENVIRONMENT=PRODUCTION
# # BACKEND_PORT=8000
# # DATABASE_URL=postgresql://postgres:[PROD_PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
# # SUPABASE_URL=https://prod-project.supabase.co
# # SUPABASE_SERVICE_ROLE_KEY=prod_service_role_key
# # REDIS_URL=rediss://default:prod_token@prod-upstash-url:6379/0
# # PUBLIC_APP_URL=https://fintral.do
